{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NosAi Test Report V2",
  "type": "object",
  "required": ["schema_version", "report_id", "created_at_utc", "source", "evidence_class", "results"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "report_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source": {"type": "string"},
    "evidence_class": {"enum": ["REAL", "CI", "SIMULATED"]},
    "host": {"type": "object"},
    "client": {"type": "object"},
    "commit": {"type": "object"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "test_suite", "test_case", "status", "observed"],
        "properties": {
          "id": {"type": "string"},
          "timestamp_utc": {"type": "string", "format": "date-time"},
          "source": {"type": "string"},
          "evidence_class": {"enum": ["REAL", "CI", "SIMULATED"]},
          "test_suite": {"type": "string"},
          "test_case": {"type": "string"},
          "component": {"type": "string"},
          "severity": {"enum": ["BLOCKER", "CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
          "status": {"enum": ["PASS", "FAIL", "ERROR", "SKIPPED", "BLOCKED", "NOT_RUN", "WARNING", "INFO"]},
          "observed": {"type": "string"},
          "expected": {"type": "string"},
          "actual": {},
          "error_type": {"type": "string"},
          "error_message": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "column": {"type": "integer", "minimum": 1},
          "stack_trace": {"type": "string"},
          "environment": {"type": "object"},
          "evidence": {"type": "array", "items": {"type": "object"}},
          "duration_ms": {"type": "number", "minimum": 0},
          "correlation_id": {"type": "string"},
          "baseline": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "summary": {"type": "object"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "publication": {"type": "object"}
  },
  "additionalProperties": true
}
